<configuration>
    <!--
      safe.log.dir is set by BootstrapLogging.preInit() before any logger is
      acquired. Default to a ./logs fallback for dev convenience if someone
      forgets to call preInit() (e.g. a plain JUnit run).
    -->
    <property name="LOG_DIR" value="${safe.log.dir:-logs}"/>

    <!--
      Redaction: secrets routinely turn up in log messages as "prikey": "abc..."
      or password=foo pairs. Strip them before they hit console or disk. The
      pattern matches case-insensitively across common secret field names.

      Defence-in-depth only. Code that logs a secret field directly (e.g. a
      whole FcEntity.toJson in a debug message) still needs fixing at the
      source — this pattern just catches field-ish substrings.
    -->

    <!--
      Pattern is conservative: matches "fieldname" followed by = or : and
      scoops up the following non-whitespace value. Regex must not contain
      } characters — logback's pattern parser treats them as group-close
      markers regardless of context.
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/safe.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/safe-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %replace(%msg){'(?i)(prikey|privkey|private_key|seed|mnemonic|secretwords|symkey|password|pwd)\s*[:=]\s*\S+', '$1=[REDACTED]'}%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %replace(%msg){'(?i)(prikey|privkey|private_key|seed|mnemonic|secretwords|symkey|password|pwd)\s*[:=]\s*\S+', '$1=[REDACTED]'}%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
